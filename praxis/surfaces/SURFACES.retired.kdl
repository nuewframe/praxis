// Retired by TS.260821.04. Each of these described the sprint-era spine — create-wave,
// start-thin-slice, create-sprint, intake, close-sprint — which the delivery graph replaced
// eighteen iterations before anything objected.
//
// The files are removed, not shimmed. v0.7.1 is tagged, so every one is recoverable by name
// with `git checkout v0.7.1 -- <path>`. Keeping both spines loaded would mean an arriving
// agent reads two methods and picks one, which is S1 — the symptom, not a mitigation of it.
//
// A retired surface whose file is still in the tree REFUSES. The record does not get to say
// a thing was retired and leave it where an agent will read it.

doctrine-surface "surface.retired.create-wave" {
    path "skills/create-wave/SKILL.md"
    kind "skill"
    serves "TS.260821.04"
    state "retired"
    retired-at "2026-08-22"
    stands-at "v0.7.1"
    because "a wave is an initiative document. A frame is a problem with symptoms and a root \
        cause, and slices are cut from a storm"
}

doctrine-surface "surface.retired.create-initiative" {
    path "skills/create-initiative/SKILL.md"
    kind "skill"
    serves "TS.260821.04"
    state "retired"
    retired-at "2026-08-22"
    stands-at "v0.7.1"
    because "same document under its own name — INIT.<name>.md, replaced by the frame and its \
        discovery"
}

