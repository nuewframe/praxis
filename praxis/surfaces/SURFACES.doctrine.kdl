// The three personas, anchored to the roles they describe (TS.260821.08).
//
// They were anchored to the FRAME by ITER.260822.04, which was a dumping ground: the frame is
// the root, so the anchor was true by construction and discriminated nothing. The decision
// recorded there predicted the falsifier would be a fourth persona. It was not — it was the
// count going from one to four in a single iteration, which is a structural tell rather than
// a numeric one.
//
// A persona is a statement about WHO may attest what, and the record now has a word for that.
doctrine-surface "surface.agent.principal-engineer" {
    path "agents/principal-engineer.agent.md"
    kind "agent"
    serves "principal-engineer"
    note "three modes — architect, implementer, reviewer — never two at once. The mode split \
        exists so that `who checked this` has an answer that is not `the person who wrote it`"
}

doctrine-surface "surface.agent.product-manager" {
    path "agents/product-manager.agent.md"
    kind "agent"
    serves "product-manager"
    note "signs the admission. The gate refuses an agent-signed approval outright, so this \
        persona is the human half of a rule the engine enforces"
}

doctrine-surface "surface.agent.product-designer" {
    path "agents/product-designer.agent.md"
    kind "agent"
    serves "product-designer"
    note "owns the design-ux phase and what a read model must answer before an actor can act. \
        A view nobody specified is a view whose emptiness means nothing"
}

