    // it left undecided claims more than it checked.

    // Frozen at open, from the slice. Removing one from the slice now
    // does not remove it from here — it makes the two disagree, and that is
    // refused.

    claim "C1" from-slice="TS.260820.11" state="met" \
        text="a hand-edited published document fails the check, named" \
        settled-by="a negative test that edits one published file and asserts non-zero exit with that filename" \
        evidence="crates/praxis-cli/tests/verify_against_git.rs::c1_a_hand_edited_published_document_fails_the_check_by_name \
            — a real repository, a real commit, a real edit, and the binary itself. Plus \
            tests/verifying.rs::every_drifted_document_is_named_not_just_counted, which also asserts \
            the UNedited file is not accused"
    claim "C2" from-slice="TS.260820.11" state="met" \
        text="neither resuming work NOR changing the capability rules makes the check fail" \
        settled-by="two tests — one advancing the record past a release, one changing an admission condition — each asserting the published tree still passes" \
        evidence="verify_against_git.rs::c2_committing_more_work_afterwards_does_not_disturb_the_check, \
            and verifying.rs::c2_resuming_work_does_not_make_the_check_fail" \
        note="the second test named in settled-by — changing an admission condition — was NOT \
            written, because there is nowhere in `verify` to pass a rule. The function takes what \
            git holds and what the tree holds, and nothing else. A rule change cannot reach it. \
            That is a stronger settlement than the test asked for and it is recorded rather than \
            quietly substituted (Z2)"
    claim "C3" from-slice="TS.260820.11" state="met" \
        text="the check runs on push with no human invocation" \
        settled-by="a CI integration test" \
        evidence=".github/workflows/delivery-graph.yml — check, test, verify-published and ready, on \
            every push and pull request, with fetch-depth 0 because C4 fails closed on an unfetched \
            history" \
        note="the harness layer, reached for the first time in this frame. P1 has said no slice \
            reaches it since the graph was seeded (Z1)"
    claim "C4" from-slice="TS.260820.11" state="met" \
        text="a missing tag or unfetched history fails the check rather than skipping it" \
        settled-by="a test on a shallow clone asserting non-zero exit" \
        evidence="verify_against_git.rs::c4_a_commit_that_cannot_be_read_fails_rather_than_skipping \
            — an index naming a commit that does not exist — and \
            verifying.rs::c4_a_commit_that_cannot_be_read_fails_rather_than_skipping. Unverifiable \
            is its own outcome in the type, so `failed()` returning true for it is not a policy \
            somebody remembered to apply"

    vet "start" state="done" at="2026-08-21T15:15:00Z" {
        condition "the tree is clean and current" verdict="passed" found="HEAD a11c63f"
        condition "the slice's scope is unchanged" verdict="passed" found="four claims, read line by line"
        condition "the harness layer can actually be reached" verdict="known-and-recorded" \
