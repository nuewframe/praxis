    // ---- DESIGN ----------------------------------------------------------------
    // ACTIVE, not complete, and F4 of ITER.260823.06 is why: `the-plan-and-the-code-agree`
    // reads `followed` only from a COMPLETE implement phase, so a design recorded before
    // implementation refuses every approach it produced.

    phase "design-system" state="complete" worked-by="agent:principal-engineer" {
        approach "read every field in both forms, and count VALUES" {
            over "declaring a form per field with `as=\"node\"` / `as=\"property\"`, and refusing a mismatch"
            over "accepting both forms but leaving cardinality counting nodes"
            over "normalising the record to one form and refusing the other"
            because "the fault is that an author writes valid KDL matching a declared field and is \
                told the field is missing. Declaring a form FIXES that by making the rule legible; \
                accepting both forms REMOVES it. Nothing in this record needs to insist on a form \
                — both are used freely today — so a form declaration would add vocabulary to a \
                method already carrying twenty-seven kinds and a hundred and fifty-eight field \
                names, to enforce a distinction nobody wants enforced"
            note "this is what C2 was cut assuming, and it is what this iteration rejects. Under \
                this approach there is no form MISMATCH to report, so C2 cannot be met as \
                written. It is carried by a finding rather than reinterpreted into something \
                weaker — settling a claim against a reading it did not have is the silent drop \
                with better manners"
        }

        approach "an identity prefix is declared on the kind that carries it" {
            over "matching on the suffix after the last dot"
            over "deriving the prefix set from the ids the record already holds"
            because "`trim_start_matches(\"CAP.\")` in four engine call sites is A4 exactly — the \
                engine encoding what the record declares. Suffix-matching and derivation both \
                replace one piece of engine knowledge with another, cleverer piece. Declaring \
                `id-prefix` on the entity puts the fact where every other fact about a kind \
                already lives, and `praxis schema` then prints it"
        }

        approach "the trail requirement and the schema are reconciled in the SCHEMA" {
            over "dropping `requires \"every entity carries a trail\"` from the gate"
            over "adding a trail field to all twenty-five kinds"
            because "eight of twenty-five kinds declare a trail and the gate demands one of every \
                entity, so writing a trail on a capability is refused as an undeclared field while \
                the gate says it is required. One of the two is wrong. The gate's reason — \
                attribution distinguishes human authorship from agent authorship — is sound and \
                worth keeping, so the requirement stays and it becomes a statement about the \
                kinds that DECLARE a trail rather than about every kind. Adding the field to all \
                twenty-five would be a schema change nobody asked for, made to satisfy a sentence"
        }

        produced "three approaches, and a claim this iteration will not meet"
    }

    phase "implement" state="complete" worked-by="agent:principal-engineer" \
