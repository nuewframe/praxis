    // ---- DESIGN ----------------------------------------------------------------
    // ACTIVE until implement completes — ITER.260823.06/F4.

    phase "design-system" state="complete" worked-by="agent:principal-engineer" {
        approach "a composed part asks the record who owns its view" {
            over "passing the owner in from each caller"
            over "deriving the owner from which module composed the part"
            because "`dashboard()` holds three literals — `CAP.delivery-record`, \
                `CAP.work-admission`, `CAP.release-binding` — and they are THIS repository's \
                capability names, compiled into the tool every repository runs. A read model \
                already declares who owns it; the composer reading that is the one answer that \
                is not a second copy. Passing it in from callers moves the literal rather than \
                removing it, and deriving it from the module makes the engine's file layout the \
                authority on the record's ownership"
        }

        approach "which shapes count as shipped instruction is declared, and a template counts" {
            over "widening the glob in the engine to include templates"
            over "auditing only what an adopter's repository ends up with"
            because "the glob IS the fault, not its width: A4 says the engine may not hold what \
                the record declares, and `which shapes are instruction` is a fact about this \
                plugin. Widening it in place fixes today's number and leaves the next shape to be \
                discovered the same way. A template is instruction with placeholders, read by an \
                agent in a repository that trusted us to send it — where it was read from is not \
                the question"
            note "the number gets much worse. 55 of 55 becomes 55 of roughly 108, and that is the \
                audit starting to work rather than the plugin getting worse. The figure was green \
                because of what it declined to look at"
        }

        approach "the minimum is computed from the schema, as its own view" {
            over "adding it to `where-to-start`, which already exists"
            over "writing it into `adopt-the-method` as prose"
            because "`where-to-start` is `needed-by=\"the-reader-of-a-release\"`, is publishable, \
                and IS the release README. This answers a different person — the adopter, before \
                any release exists for them — and folding the two would put a working answer \
                inside a frozen document. Prose in a skill is a second copy of the schema and \
                drifts the first time a kind is added, which is the fault the whole record exists \
                to attack"
            note "so a new read model, `what-you-must-declare`, added to the storm and owned by \
                delivery-record. Two slices declaring one view is the mis-cut the gate caught \
                between TS.260823.03 and TS.260823.04 an hour ago, and this is the same shape \
                found before it cost anything"
        }

        produced "three approaches, and a read model the storm did not hold"
    }

    phase "implement" state="complete" worked-by="agent:principal-engineer" \
