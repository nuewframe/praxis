// The NOTIONAL architecture. It models what the capabilities are to each other — what each
// decides, what each owns, what crosses between them and in which shape. It names no
// framework, no language, no storage, no file layout and no command surface.
//
// It is notional because it must outlive every one of those. KDL, a Rust engine and a CLI
// are this decade's binding of it; the model below is what a later binding would have to
// keep in order still to be Praxis.
//
// Derivation, not assertion. Every element here traces to a cluster, a policy or an
// acceptance criterion that already exists — the same rule ES.260819.01 applies to
// capabilities, applied to the architecture that relates them. Where this record disagrees
// with a committed capability record, the disagreement is stated and the correction is
// OWED, not applied: naming and re-cutting capabilities is the maintainer's act.

notional-architecture "NA.260820.01" {
    slug "capabilities-seams-and-who-may-change-what"
    title "Five capabilities, one substrate, three seams, and single-writer ownership per fact"
    frame "FRAME.260819.01"
    derived-from "ES.260819.01" "WALK.260820.01" "WALK.260820.02"
    state "sought"
    exercised-by "TS.260820.04" "TS.260820.05" "TS.260820.06" "TS.260820.07" "TS.260820.08" \
        "TS.260820.09" "TS.260820.10" "TS.260820.11" "TS.260820.13" "TS.260820.16" \
        "TS.260820.17" "TS.260820.18" \
        note="twelve of eighteen slices have been walked. The remainder accrete as they are \
            picked up — an architecture derived from exercise is finished when the slices are, \
            not before"

    // ================================================================
    // WHAT THIS RECORD DELIBERATELY DOES NOT DECIDE.
    //
    // Each of these is downstream and replaceable. Any of them changing must leave every
    // element below standing; if one cannot, the element was a tool decision in disguise.
    // ================================================================

    excludes "the encoding of facts" because="KDL is a binding. The model needs facts to be typed, addressable and trailed — not to be KDL"
    excludes "identity FORMATS, folder placement, and what may sit in the state root" \
        because="the schema below says a slice has an identity and an owner. What that id LOOKS \
            like and which directory holds it are layout, decided on ADR.260819.01"
    excludes "the engine and its language" because="ADR.260819.01 decided a compiled Rust CLI. Nothing below depends on it"
    excludes "file and directory layout" because="which node lives at which path is a locator concern. The model needs identity, not location"
    excludes "the command surface" because="a command in this model is an actor's intent, not a CLI verb"
    excludes "storage, indexing and query mechanics" because="the substrate below states what must be true of holding facts, never how"
    excludes "distribution and the install paths" because="FRAME.260819.01 declares them out of scope; ES.260819.01 could not derive them (E11)"

    // ================================================================
    // THE SUBSTRATE — beneath all five, owned by none.
    //
    // Factored out of CAP.delivery-record by WALK.260820.02/W12. It is not a capability:
    // it refuses nothing about the work and decides nothing. It is what every capability
    // needs in order to hold a fact at all.
    // ================================================================

    substrate "the-record" {
        is "the typed, trailed, addressable fact store every capability writes its own facts into"
        not "it is not a capability. It refuses malformed structure, never a bad decision, and it \
            has no opinion about the method being followed"

        must "hold every fact as typed and addressable, so a fact is found by following an edge rather than by knowing where it sits"
        must "apply exactly one change set at a time, whole or not at all"
        must "carry a trail entry on every change, naming who and when"
        must "answer a named query as a typed fact set, without the asker reaching into how facts are held"
        must "refuse a write whose author does not own the fact being written"

        derived-from "WALK.260820.01" locator="the engine sits under all four as a seam, not a capability"
        derived-from "WALK.260820.02" locator="W12"

        falsifier "if the substrate ever needs to know what a slice, a claim or a release MEANS \
            in order to hold it, it is not a substrate and the factoring is wrong"
    }

    // ================================================================
    // THE EXTERNAL PARTICIPANT — history.
    //
    // ES.260819.01 declares one clock and the record is not it. Named here because an
    // unnamed external dependency is crossed silently the first time caching looks cheap.
    // ================================================================

    external "history" {
        is "an immutable, content-addressed history that exists outside the record and owns what actually happened"
        bound-to "git" note="the binding. The model requires immutability, content addressing and an external owner — not git"

        record-may "point at a position in it, and record that pointer once"
        record-may-not "mirror it, cache its contents, or derive a second ordering from it" \
            because="a copy whose fidelity to history is unverifiable-without-checking-history is \
                this frame's root cause reproduced one level up (E21)"

        trust-direction "one way. The record trusts history; history knows nothing of the record"
        consequence "a claim about history — that a commit resolves, that it contains a directory — \
            is settled by asking history, never by consulting the record (TS.260820.09 C3)"

        derived-from "ES.260819.01" locator="E20" "E21"
        derived-from "WALK.260820.02" locator="W14"
    }

    // ================================================================
    // THE CAPABILITIES — what each DECIDES, and what it may never do.
    //
    // `decides` is the load-bearing field. A capability that decides nothing is substrate;
    // a capability that decides something another capability owns is a boundary error.
    // ================================================================

    capability-role "delivery-record" {
        decides "whether a fact about the method's own derivation is well formed — a capability that traces to no cluster, a slice without the shape, symptoms that do not converge, a resolution without an attacking release, a view with no declared lifetime, a guide ahead of promoted truth"
        owns-facts "problems and their symptoms" "discovery, its walks and its rejected options" "capabilities" "slices and their claims" "declared lifetimes" "usage prose"
        consumes "release-facts@v1" from="release-binding" \
            for="resolution-names-a-release and guide-follows-promoted-truth, which are enforceable only against what a release bound"
        emits "slice-facts@v1" to="work-admission" "claim-settlement"
        emits "read-model@v1" to="document-projection" views="capabilities-and-what-they-own" "what-is-currently-true" "how-to-use-a-capability" "the-problem-as-it-stands"
        never "judge whether a decision was good, or whether work was done well. It refuses shape and derivation, and nothing else"
        owed "restate merge-reason on the consistency argument rather than the fundability one (W13)"
    }

    capability-role "work-admission" {
        decides "whether an iteration may open, and whether an open iteration may close"
        owns-facts "iterations and their whole lifecycle" "frozen dependencies" "refusals and the condition that caused each"
        consumes "slice-facts@v1" from="delivery-record" for="what a slice depends on, and what it declared"
        consumes "settlement-facts@v1" from="claim-settlement" for="which claims are settled and which are carried, at close"
        emits "read-model@v1" to="document-projection" views="what-is-ready-to-pick-up"
        emits "iteration-facts@v1" to="release-binding"
        never "judge the work. It judges preconditions at open and accounting at close, and looks at the work itself at neither"
        owed "the iteration is one entity and this capability owns it end to end. `not` currently says \
            `and then it is finished`, which W8 falsifies. TS.260820.07 re-files here, and \
            no-silent-drop moves here with it (W8, W9)"

        // The gate's conditions, declared rather than coded. A4 forbids the engine holding
        // a rule the record does not state, and WHICH conditions decide admission is such a
        // rule. The engine carries a check per name; a condition naming a check the engine
        // does not have is REPORTED AS UNCOMPUTED, never quietly passed. That is the whole
        // difference between `nothing blocks this` and `blocking was not computed`, which is
        // read-model@v1's third constraint at the granularity of a single condition.
        // Declared by ITER.260821.03, from ES.260819.01 `pick-up` and the iteration-control
        // cluster's `it judges readiness and disjointness only`.
        admits "an iteration on a slice" {
            condition "slice-is-shaped" check="slice-is-shaped" \
                because="a slice the checker refuses is not work waiting to start, it is a defect"
            condition "dependencies-delivered" check="dependencies-delivered" \
                because="an iteration standing on undelivered work is standing on nothing" \
                caveat="P2 — every dependency in the tree today names a SLICE, which the schema \
                    forbids in favour of a frozen seam. The check reads the id out of the prose \
                    and says that it did, so the caveat is visible in the answer rather than \
                    filed in a finding nobody reads"
            condition "no-iteration-in-flight" check="no-iteration-in-flight" \
                because="at most one open iteration per slice — the iteration entity's own constraint"
            condition "nothing-left-to-admit" check="nothing-left-to-admit" \
                because="a slice whose claims are all met and whose iteration is closed has nothing \
                    to admit. It is not blocked; it is done, and the two must not look alike"
            condition "work-is-disjoint" \
                uncomputed="no seam manifest exists, so what two iterations would touch cannot be \
                    compared. Disjointness is half of what this capability says it judges, and \
                    half of what it judges is currently not computed at all" \
                because="two iterations that overlap produce a merge, and a merge is where the \
                    record and the tree stop agreeing"
            condition "the-slice-is-the-best-available" judgement=#true \
                because="selection is the maintainer's judgement and the tool does not rank. \
                    Declared anyway, so the answer shows the reader which part of the gate it \
                    did not decide for them"
        }
    }

    capability-role "claim-settlement" {
        decides "whether a stated claim is met by its evidence, whether evidence names a layer the slice declared, and whether a shortfall has been carried"
        owns-facts "evidence and the layer each names" "claim settlements" "findings and their triage" "decisions and their alternatives"
        consumes "slice-facts@v1" from="delivery-record" for="the layer set and the claim set a slice declared"
        emits "settlement-facts@v1" to="work-admission" "release-binding"
        emits "read-model@v1" to="document-projection" views="what-this-iteration-claims-and-has-shown" "the-decisions-that-shaped-this"
        never "produce evidence, judge its quality, or perform a close. It supplies the settlement; the iteration's owner acts on it"
    }

    capability-role "release-binding" {
        decides "what a version contains, when it is cut, and what current truth becomes as a consequence"
        owns-facts "bindings of an iteration to a version" "releases and their index into history" "the current-truth field of every capability record"
        consumes "iteration-facts@v1" from="work-admission" for="whether an iteration closed"
        consumes "settlement-facts@v1" from="claim-settlement" for="which claims are unsettled, so a refusal can name them"
        consumes "lifetime-facts@v1" from="delivery-record" for="which views are publishable, from which the published set is DERIVED and never listed by hand"
        consumes "problem-facts@v1" from="delivery-record" for="which symptoms a release resolved. The release node does not store this twice — it is read from the symptoms that name it"
        emits "release-facts@v1" to="delivery-record"
        emits "read-model@v1" to="document-projection" views="the-published-set-for-a-release"
        never "write a document, or hand-edit truth that did not come from bound work"
        note "it authors a field inside a record delivery-record owns. Under per-fact ownership \
            this crosses no boundary — see invariant single-writer-per-fact (W10)"
    }

    capability-role "document-projection" {
        decides "how a declared view becomes a whole document, what lifetime that document has, and whether a published one still matches the release it claims"
        owns-facts "publications and what each depicts" "detected drift"
        consumes "read-model@v1" from="delivery-record" "work-admission" "claim-settlement" "release-binding"
        never "mutate the record, edit a document toward a new state, or know what any view CONTAINS"
        note "the only capability that consumes from all four and emits to none of them. E7's \
            argument for why it sits closest to the frame's root cause is visible in the shape"
    }

    // ================================================================
    // THE SEAMS — what crosses a boundary, in which direction, in what shape.
    //
    // Three, and only one of them is new. `read-model@v1` came from WALK.260820.01;
    // `fact-set@v1` and `change-set@v1` from WALK.260820.02. A fourth would be a smell:
    // every remaining edge in the graph is one of these three.
    // ================================================================

    seam "read-model@v1" {
        direction "a content-owning capability → document-projection"
        carries "one view's content as a typed result: sections, columns, rows of values, referenced prose, and its own declared emptiness"
        shape-at "WALK.260820.01#read-model-v1"
        purpose "so a renderer can compose a document without ever knowing what a view MEANS"

        constraint "cells carry values, never markup" because="the moment a capability may emit presentation, the split is fiction while still passing TS.260820.10 C3"
        constraint "prose is referenced, not inlined" because="prose a human wrote is data; prose a renderer composed is presentation"
        constraint "empty sections declare their own emptiness" because="a reader who cannot tell `nothing is blocked` from `blocking was not computed` is reading the trust-transfer problem at table granularity"
        constraint "an archival result names the version it depicts" because="stamp-on-publish enforced in the shape rather than in the renderer"

        falsifier "if projection ever needs a code path specific to one view, the read-side split is fake" \
            state="tested, did not fire" by="WALK.260820.01/W2"
    }

    seam "fact-set@v1" {
        direction "the capability that OWNS a fact → the capability that must DECIDE with it"
        carries "the answer to a named query, as typed values, as of a stated moment"
        shape-at "WALK.260820.02#fact-set-v1"
        purpose "so a capability can compute a verdict from a typed input instead of reaching into \
            how another capability holds its state — which is the only way the verdict can be \
            recomputed from the record later, and the frame's principle requires that it can be"

        constraint "the consumer declares the query; the owner answers it" because="a consumer composing its own query over another's facts is reading internals with extra steps"
        constraint "no verdict field. The owner states facts; the consumer decides" because="a fact set carrying a verdict is an instruction wearing a fact's shape, and it moves the decision away from the capability that owns the act"
        constraint "answered as of a moment, never cached across a change set" because="a gate that decided from a stale answer has a refusal nobody can recompute"
        constraint "an empty answer declares its own emptiness" because="carried over from read-model@v1 for the same reason at a different granularity"

        instance "slice-facts@v1"      from="delivery-record"  to="work-admission" "claim-settlement"
        instance "settlement-facts@v1" from="claim-settlement" to="work-admission" "release-binding"
        instance "iteration-facts@v1"       from="work-admission"   to="release-binding"
        instance "release-facts@v1"    from="release-binding"  to="delivery-record"
        instance "lifetime-facts@v1"   from="delivery-record"  to="release-binding"
        instance "problem-facts@v1"    from="delivery-record"  to="release-binding" \
            note="a release's `resolves` is derived from the symptoms that name it, never stored \
                beside them. The same argument as `history`, one scale down: a second copy whose \
                fidelity is unverifiable-without-checking-the-first is what this frame is about"

        falsifier "if any consumer needs a field the owner would not publish to every consumer, \
            the seam is a private channel between two capabilities and the boundary is drawn wrong"
    }

    seam "change-set@v1" {
        direction "any capability → the-record"
        carries "every write one command makes, each naming the fact it changes and its author"
        shape-at "WALK.260820.02#change-set-v1"
        purpose "so atomicity is a property of the model rather than a promise each capability makes separately"

        constraint "one command, one change set" because="promote-truth moves truth on many capability records and is still one"
        constraint "whole or nothing, leaving the record unchanged on failure" because="a half-applied promotion is worse than an unapplied one — it is wrong in a way nobody can see (TS.260820.17 C1)"
        constraint "every write names the fact it changes" because="the per-fact writer rule must be checkable before application, not by review afterwards"
        constraint "a change set spanning the record and history still applies as one" because="TS.260820.09 C2 requires the tag and the index node to succeed or fail together"

        settles "TS.260820.09 C2" "TS.260820.17 C1" "TS.260820.07 C3" \
            note="three acceptance criteria, in three capabilities, all settling against this one \
                structure. That they were written before it was named is the evidence it is real"
    }

    // ================================================================
    // HOW TO READ THE SLICE GRAPH.
    //
    // Both of these were found by checking this record against the eighteen slices rather
    // than by walking. Without them the graph shows five cross-capability violations that
    // are not violations, and the two that ARE get lost among them.
    // ================================================================

    reading-rule "needs-read-model is actor-facing" {
        states "a slice's `needs-read-model` is what the ACTOR must see before issuing the command. It reaches them through document-projection and is never a capability consuming another capability's view"
        without-it "TS.260820.16 reads as release-binding reaching into delivery-record, when it is a maintainer looking at a dashboard before deciding to bind"
        consequence "no capability consumes a read model except document-projection. If one ever does, either the view is really a fact set or the boundary is wrong"
    }

    reading-rule "feeds-read-model is a dependency pointing backwards" {
        states "when a slice of A feeds a view owned by B, nothing of A writes into B. A authors facts that B's view is computed FROM — so the edge is B consuming a fact set from A, drawn in the opposite direction to the one the graph shows"
        without-it "cut-slice, declare-lifetime and resolve-symptom all read as delivery-record writing into other capabilities' views"
        consequence "every `feeds-read-model` crossing an ownership boundary must have a matching `consumes` in the other direction, or a fact is reaching a view with no seam carrying it"
        found "one missing edge — release-binding consumes lifetime and problem facts from delivery-record, which TS.260820.12 and TS.260820.18 both require and no record declared"
    }

    // ================================================================
    // INVARIANTS THAT SPAN CAPABILITIES.
    //
    // Not policies — ES.260819.01's ten policies each belong to one capability. These are
    // true of the relationships, so no single capability can hold them.
    // ================================================================

    invariant "single-writer-per-fact" {
        states "every fact has exactly one authoring capability. An entity may hold facts with several different authors"
        so-that "ownership does not have to follow containment, and a capability can author what it owns inside a record it does not"
        example "release-binding authors a capability record's current-truth field; delivery-record owns the record"
        checkable-by "a write whose author does not own the named fact is refused before the change set applies"
        derived-from "WALK.260820.02" locator="W10"
        supported-by "TS.260820.17" locator="C2"
    }

    invariant "judgement-travels-as-fact" {
        states "a capability hands another its findings, never its instructions. The receiving capability re-decides"
        so-that "the capability that owns an act is the only one that ever performs it, and every refusal can be recomputed from the inputs that produced it"
        example "claim-settlement states which claims are unsettled; work-admission refuses the close"
        checkable-by "a fact set carrying a verdict field, or a capability emitting an event it does not own"
        derived-from "WALK.260820.02" locator="W7" "W8"
    }

    invariant "enforcement-follows-the-act" {
        states "a policy is enforced by the capability that owns the act it refuses, not by the one that owns the concept it is about"
        so-that "a refusal happens where the change would happen, and cannot be routed around by calling the act from elsewhere"
        example "no-silent-drop is about claims and refuses a CLOSE, so it belongs to the iteration's owner"
        checkable-by "a policy listed on a capability that owns none of the acts it refuses"
        derived-from "WALK.260820.02" locator="W9"
        note "applying it reassigns exactly one policy of ten, which is why it reads as a discovery \
            rather than a change — the model was already doing this without saying so"
    }

    invariant "no-capability-reads-another-s-state" {
        states "facts cross only as fact sets answering a declared query. Nothing reads how another capability holds anything"
        so-that "a change to how one capability stores its facts cannot force a change in a capability that merely decides with them"
        example "work-admission never learns how a slice is held, only what it depends on"
        checkable-by "a consumer that names a field no fact set publishes"
        derived-from "ES.260819.01" locator="E10 — the coupling argument, arriving on the write side"
        derived-from "WALK.260820.02" locator="W7"
    }

    invariant "refusal-is-a-recorded-fact" {
        states "every refusal is a fact with the condition that caused it, held by the capability that refused"
        so-that "a gate that was never invoked and a gate that refused stop looking identical afterwards"
        example "PickupRefused, CloseRefused, ConvergenceRefused, DriftDetected"
        checkable-by "a refusal path that produces no fact"
        derived-from "ES.260819.01" locator="E6" "refusal-is-a-fact"
    }

    // ================================================================
    // WHAT THIS ARCHITECTURE OWES.
    //
    // Corrections it forces on records already committed. Held as obligations, not applied:
    // naming and re-cutting capabilities is a maintainer command, and an architecture that
    // silently rewrote the capabilities it was derived from would be asserting, not deriving.
    // ================================================================

    owes "re-file TS.260820.07 under CAP.work-admission" from="W8" \
        because="the iteration is one entity and work-admission owns it. The slice's content is right; the capability on it is wrong"
    owes "move no-silent-drop from CAP.claim-settlement to CAP.work-admission" from="W9"
    owes "restate CAP.work-admission's `not` — `and then it is finished` is false of a capability that owns an iteration through its whole life" from="W8"
    owes "restate CAP.delivery-record's merge-reason on the consistency argument" from="W13" \
        note="the verdict survives; the reasoning on the record is not the reasoning that justifies it"
    owes "record read-model@v1, fact-set@v1 and change-set@v1 as frozen seam contracts once there is a manifest to freeze them in" from="W7" "W11"
    owes "declare the notional-architecture record kind in ADR.260819.02's normative block" \
        note="this record is applied but undeclared, the same status E12 records for the file-naming rule. \
            The checker may not enforce an invariant the record does not declare, and it may not \
            validate a kind the record does not know"

    // ================================================================
    // OPEN — carried forward rather than settled here.
    // ================================================================

    open "whether problem facts and derivation facts stay one capability" \
        falsifier="if problem facts ever change on a different cadence, or by a different writer, than derivation facts, the merge in CAP.delivery-record is wrong" \
        note="W13 corrected the argument and left the verdict standing. Six slices remain unwalked, \
            and TS.260820.18 is the only one on this boundary that has been exercised"

    open "what an iteration IS, as an entity" \
        note="work-admission owns it, three capabilities write facts about it, and no record defines \
            it. It has surfaced as an entity in every walk and been modelled in none"

    open "whether document-projection consuming from all four is a hub or a correct sink" \
        falsifier="if projection ever needs to emit anything back into the record beyond its own publication facts, it is a hub and the topology is wrong"

    // ================================================================
    // THE SCHEMA — what exists in the record, and what may relate to what.
    //
    // Recovered from the withdrawn ADR.260819.02 and re-homed here, because this is not a
    // decision: it is the model. What a frame IS, what a slice IS, which relationships are
    // legal — that is what the capabilities are to each other, stated as entities rather
    // than as behaviours. An ADR is a technical decision, and a schema that needed thirteen
    // amendments in a day was never one.
    //
    // Sorted on the way in. Anything that was really about ENCODING or LAYOUT — filename
    // patterns, folder placement, Markdown in the tree, empty directories — went to
    // ADR.260819.01 instead, where the layout is decided. What is left is notional: it
    // survives KDL being replaced.
    // ================================================================

    schema {
        identity "a stable id, assigned once, never reused, and allocable without coordination" \
            because="two agents naming two things at the same moment must not have to agree first" \
            note="the literal id FORMAT is a layout decision and lives on ADR.260819.01"

        entity "frame" is="a problem — symptoms, one root cause, one principle" \
            completes="never; its symptoms resolve individually, each naming a release" \
            note="only one frame exists, so every cardinality here is inferred from a sample of ONE. \
                Required is limited to what a frame's own definition demands; the rest stays optional \
                until a second frame says otherwise (ITER.260821.02/R4)" {
            field "slug"             each="1"
            field "title"            each="1"
            field "symptom"          each="1..n" holds="symptom" because="a frame with no symptom cannot resolve, and resolution is per symptom"
            field "root-cause"       each="1" because="the convergence gate — symptoms that do not reduce to one cause were more than one problem"
            field "principle"        each="1"
            field "trail"            each="1"
            field "current-ceiling"  each="0..1"
            field "affected"         each="0..1"
            field "baseline"         each="0..1"
            field "cost-of-inaction" each="0..1"
            field "identifies"       each="0..n"
            field "retires"          each="0..n"
            field "out-of-scope"     each="0..n"
            field "created-by"       each="0..1"
            field "created-at"       each="0..1"
        }
        entity "thin-slice" is="an atomic vertical slice — one command or one read model, cut so it can exercise a capability" \
            states="proposed active delivered dropped" {
            // The shape a checker refuses, made machine-readable. Derived from the storm's
            // `slice-shape` policy and E13's two-kind split — not invented here. Added by
            // ITER.260820.01/P7: the schema declared entities and relations but no FIELDS,
            // so the validator had nothing to read and would have had to hardcode them,
            // which is exactly what A4 forbids.
            field "slug"           each="1"
            field "title"          each="1"
            field "kind"           each="1" one-of="command" "view"
            field "realizes"       each="1" references="capability"
            field "from-storm"     each="1" references="event-storm"
            field "actor"          each="1"
            field "trigger"        each="1"
            field "outcome"        each="1"
            field "layer"          each="1..n" because="verticality is the declared set, and a slice with none asserts nothing"
            field "claim"          each="1..n" because="a slice with no claim cannot go unmet, so nothing can object"
            field "command"        each="1"    when-kind="command"
            field "produces-event" each="1..n" when-kind="command" because="a refusal is a fact, so a refusable command names both outcomes"
            field "read-model"     each="1..n" when-kind="view" because="E13 — a view slice writes nothing and names the view instead"

            // The optional half. Enumerated by turning the check on and reading what it
            // refused, rather than by recalling what a slice usually carries — the record
            // told us its own vocabulary (ITER.260821.01/Q1).
            field "state"            each="0..1" one-of="proposed" "active" "delivered" "dropped"
            field "scenario"         each="0..1"
            field "step"             each="0..n"
            field "excludes"         each="0..n" because="scope sealed at cut time, so drift has something to hit"
            field "attacks"          each="0..n" references="symptom"
            field "depends-on"       each="0..n"
            field "useful-alone"     each="0..1" because="what you get if this ships and nothing after it does"
            field "needs-read-model" each="0..n"
            field "feeds-read-model" each="0..n"
            field "content-owned-by" each="0..n"
            field "composes"         each="0..1"
            field "lifetime"         each="0..1" one-of="working" "archival"
            field "rendered-by"      each="0..1"
            field "does-not-prove"   each="0..1"
            field "amended-by"       each="0..n"
            field "cut-from"         each="0..1"
            field "principle-note"   each="0..1"
            field "note"             each="0..n"
            field "proves"           each="0..1"
        }

        entity "config" is="this repository's binding to the schema — it may bind, and may never declare" \
            note="a root kind the record carried from the first commit and no schema ever named. \
                Found by ITER.260821.01 the moment the rule it builds was turned on, which is the \
                slice proving itself against a real omission rather than a fixture" {
            field "repository"  each="1"
            field "governed-by" each="0..1" because="unbound today — the schema moved off the ADR and no node has claimed it"
            field "profile"     each="1"
            field "versioning"  each="0..1"
            field "invariants"  each="0..1"
            field "paths"       each="1"
        }
        entity "notional-architecture" is="what the capabilities are to each other, free of any tool decision" \
            states="sought held" \
            note="one record; cardinalities conservative for the same reason as frame" {
            field "slug"            each="1"
            field "title"           each="1"
            field "frame"           each="1" references="frame"
            field "state"           each="1" one-of="sought" "held"
            field "schema"          each="1" because="the model's own vocabulary. Without it nothing in the record can be checked at all"
            field "trail"           each="1"
            field "derived-from"    each="0..n"
            field "exercised-by"    each="0..1"
            field "excludes"        each="0..n" because="what it refuses to decide is what makes it notional"
            field "substrate"       each="0..n"
            field "external"        each="0..n"
            field "capability-role" each="0..n"
            field "seam"            each="0..n"
            field "reading-rule"    each="0..n"
            field "invariant"       each="0..n"
            field "owes"            each="0..n"
            field "open"            each="0..n"
        }
        entity "capability" is="a permanent doing the system must have" \
            states="sought active retired" \
            completes="never; it is retired" {
            field "doing"            each="1" because="a capability that names no doing is a noun someone liked"
            field "not"              each="1" because="an exclusion something else covers, never scope restated"
            field "state"            each="1" one-of="sought" "active" "retired"
            field "shipped"          each="0..n" \
                because="what shipped for this capability, and in which release. Written by \
                    promotion and recomputed by promoted-truth-is-derived — never hand-written"
            field "derived-from"     each="1" references="event-storm" \
                because="capability-must-trace — a capability owns a cluster of events from a storm, or it is an assertion"
            field "from-cluster"     each="1" references="cluster" \
                because="the cluster IS the derivation. Naming a storm without the cluster inside it proves nothing"
            field "owns-event"       each="1" unique-in="capability" \
                because="an event kept consistent by two capabilities has no single owner, and the boundary between them is drawn wrong"
            field "owns-read-model"  each="1..n"
            field "gate-test"        each="1..n" because="the four tests, each with the reason it passes"
            field "keeps-consistent" each="1"
            field "attacks"          each="1" references="symptom"
            field "trail"            each="1"
            field "enforces"         each="0..n"
            field "principle-note"   each="0..1"
            field "merge-reason"     each="0..1"
            field "split-reason"     each="0..1"
            field "narrowed-by"      each="0..1"
            field "property"         each="0..n"
        }

        entity "cluster" is="a group of events that must stay consistent together — the unit a capability is derived FROM" \
            note="contained in an event-storm. Declared so `from-cluster` resolves rather than merely being present"

        entity "symptom" is="one observable thing that is wrong, resolving on its own schedule by naming a release" \
            note="contained in a frame. Declared so `attacks` resolves"
        entity "adr" is="a durable technical decision, its argument, its alternatives, and its corrections" \
            states="proposed accepted superseded" \
            note="one record; cardinalities conservative for the same reason as frame" {
            field "slug"       each="1"
            field "title"      each="1"
            field "state"      each="1" one-of="proposed" "accepted" "superseded"
            field "body"       each="1" because="a decision with no argument is an instruction"
            field "approval"   each="1..n" because="an accepted decision nobody signed is unsigned"
            field "trail"      each="1"
            field "decided-at" each="0..1"
            field "matured-at" each="0..1"
            field "deciders"   each="0..1"
            field "raised-by"  each="0..1"
            field "supersedes" each="0..n"
            field "amendment"  each="0..n"
            field "enforces"   each="0..1"
            field "open"       each="0..n"
        }
        entity "release" is="an index into history — what it binds, what it resolves" \
            states="planned released" \
            owned-by="release-binding" \
            note="machine-owned. Every field is derived from what was bound, so the record is \
                composed whole on each bind rather than edited — there is nothing in it a human \
                wrote that a rewrite could lose. Declared with fields by ITER.260821.07" {
            field "version"      each="1"
            field "state"        each="1" one-of="planned" "released"
            field "binds"        each="0..n" references="iteration" \
                because="a version with no content and a version nobody has computed are not the \
                    same thing, so an empty one says so rather than being absent"
            field "proposed-bump" each="1" \
                because="the record PROPOSES from the configured rules. Confirming is the \
                    maintainer's, at cut"
            field "proposal-incomplete-for" each="0..n" \
                because="an iteration that declares no `contributes` informed the proposal with \
                    nothing, and a proposal computed from half the work is not a proposal"
            field "confirmation" each="0..1"
            field "index"        each="0..1" when-kind="released" \
                because="a release without an index is a release nothing can be verified against. \
                    It POINTS at a commit and never mirrors what git already holds"
            field "seal"         each="0..1" when-kind="released"
            field "resolves"     each="0..n" references="symptom"
            field "trail"        each="1"
        }
        entity "iteration" is="one attempt at a slice — what ITERATE produces" \
            states="open working closed abandoned" \
            owned-by="work-admission" \
            never-deleted=#true because="a closed iteration is history, and history is what makes a slice's maturity legible" \
            constraint="at most one open per slice" \
            note="declared with fields by ITER.260821.01 so that `phase` — a contained entity — can \
                be distinguished from a field at all. A container with no shape cannot refuse what \
                it holds, which is what let `phase` go missing" {
            field "slug"      each="1"
            field "on-slice"  each="1" references="thin-slice"
            field "state"     each="1" one-of="open" "working" "closed" "abandoned"
            field "opened-at" each="1"
            field "opened-by" each="1"
            field "closed-at" each="0..1"
            field "outcome"   each="0..1" one-of="continue" "pivot" "stop"
            field "approval"  each="1..n" because="the human's ask is the only gate, and it is recorded or it did not happen"
            field "vet"       each="1..n" because="vetted at create and again at start"
            field "frozen"    each="0..1"
            field "claim"     each="0..n"
            field "layer"     each="0..n"
            field "layer-set" each="0..1"
            field "contributes" each="0..n" \
                because="which configured bump rule this work matches. Declared by the iteration \
                    rather than inferred, because only whoever did the work knows what kind of \
                    change it was — and a bump proposal inferred from a diff is a guess about \
                    intent"
            field "phase"     each="0..n" holds="phase" because="a contained entity, not a value — without `holds` it is indistinguishable from a field, which is how it went missing"
            field "decision"  each="0..n"
            field "finding"   each="0..n"
            field "close"     each="0..1"
            field "trail"     each="1"
        }

        entity "refusal" is="a pick-up the gate refused, and the condition that failed" \
            owned-by="work-admission" \
            never-deleted=#true because="a refusal nobody kept is a gate nobody can prove ran" \
            note="declared by ITER.260821.04, and the first kind the record needed that discovery \
                never named. `refusal-is-a-fact` has been a policy since the storm; the thing the \
                policy produces had no shape, so nothing could hold one. It sits in iterations/ \
                because an admission and a refusal are the two outcomes of ONE command, and a \
                container is named for what its contents are to the owner" {
            field "on-slice"     each="0..1" references="thin-slice"
            field "on-iteration" each="0..1" references="iteration" \
                because="a close is refused about an ITERATION, not about the slice under it"
            field "on-version"   each="0..1" \
                because="a bind is refused about a VERSION, which is not an entity the refusal \
                    can reference until a release exists to be refused against"
            field "at"        each="1"
            field "by"        each="1"
            field "asked-by"  each="0..1" because="the human whose ask was refused, where there was one"
            field "condition" each="1..n" \
                because="a refusal that does not name the condition is indistinguishable from \
                    never having been asked, which is S3"
            field "trail"     each="1"

            // on-slice, on-iteration and on-version are `0..1` and EXACTLY ONE should be
            // present. The schema cannot say that: it has cardinality per field and no way
            // to constrain a choice ACROSS fields. So a refusal naming nothing at all is
            // accepted today. Recorded as W4 — the first thing the record has needed to say
            // that its own vocabulary cannot express.
        }

        entity "phase" is="one stage of work inside an iteration — WHEN in the attempt, as a layer is WHERE in the stack" \
            states="pending active complete skipped" \
            owned-by="the iteration" \
            kinds="design-ux · design-system · implement · learn · teach" \
            note="undeclared until ITER.260820.01/P8. It survived the withdrawal of ADR.260819.02, \
                where it was a first-class node, and nothing carried it forward — so the first \
                iteration went from admission straight to implement with no phase recorded" \
            shape="carried entirely as properties — the node's own argument IS the kind. Declaring \
                child fields for it would be wrong, so it is deliberately shapeless and reported \
                as such. Property shapes are a separate cut (TS.260821.01 excludes them by name)"

        entity "event-storm" is="one sweep of a domain's timeline — the evidence a capability is derived FROM" \
            note="declared with fields so `read-model` stops being indistinguishable from a field" {
            field "title"      each="1"
            field "frame"      each="1" references="frame"
            field "scope"      each="0..1"
            field "held-at"    each="0..1"
            field "held-by"    each="0..1"
            field "actor"      each="0..n"
            field "external"   each="0..n"
            field "command"    each="1..n"
            field "event"      each="1..n" claimed-by="capability.owns-event" \
                because="an event no capability owns belongs to nothing — reported, not refused"
            field "policy"     each="0..n"
            field "read-model" each="0..n" holds="read-model" \
                because="each carries its own lifetime declaration, which is what the published set \
                    is derived from (TS.260820.12)"
            field "cluster"    each="0..n" holds="cluster" because="a capability that traces to no cluster is an assertion"
            field "process"    each="0..1"
            field "finding"    each="0..n"
        }

        entity "read-model" is="a view an actor must see before acting, owned by exactly one capability" \
            note="already load-bearing in every slice's needs/feeds edges and never declared"

        relates "realizes"      from="thin-slice" to="capability" each="1" \
            because="a slice with no capability is unfunded work"
        relates "derived-from"  from="capability" to="event-storm" each="1..n" \
            because="a capability that traces to no cluster is an assertion, which is this frame's root cause"
        relates "identifies"    from="frame" to="capability" each="0..n"
        relates "from-storm"    from="thin-slice" to="event-storm" each="1"
        relates "raised-by"     from="adr" to="frame" each="1" \
            because="a decision belongs to the problem that forced it" write-once=#true
        relates "supersedes"    from="adr" to="adr" each="0..1"
        relates "exercised-by"  from="notional-architecture" to="thin-slice" each="1..n" \
            because="an architecture nothing exercised is a drawing"
        relates "needs-read-model" from="thin-slice" to="read-model" each="0..n" \
            note="actor-facing. See the reading rules above — this is never a capability seam"
        relates "feeds-read-model" from="thin-slice" to="read-model" each="0..n" \
            note="points BACKWARDS as a dependency. See the reading rules above"
        relates "on-slice"      from="iteration" to="thin-slice" each="1" write-once=#true \
            because="an iteration is an attempt at ONE slice. Which attempt it is, is derived by ordering the iterations on that slice — never stored"
        relates "depends-on"    from="thin-slice" to="seam" each="0..n" \
            constraint="never slice → slice. Dependency is only ever on a frozen contract, which is what makes disjointness a query" \
            violated-by="seventeen of eighteen slices today. Carried as open"

        requires "every entity carries a trail" \
            entry-common="at" "by" "action" append-only=#true \
            because="attribution distinguishes human authorship from agent authorship, which is the \
                distinction a method built on trust transfer exists to make legible"
        requires "only a human may sign an approval" kinds="acceptance" "admission" \
            because="an agent-signed approval is the trust-transfer problem expressed as a signature"
        requires "an iteration is vetted twice — at the ask to create, and again at the ask to start" \
            because="the tree moves in between. An admission computed against a tree that has since \
                changed is an admission of something else, and the second vet is where a stale \
                freeze is caught"
        requires "an iteration carries a signed admission before it may be worked" \
            because="selection IS the commitment, and ITERATE has exactly one gate. The human's ask \
                to start an iteration is that approval — so it is recorded as one, or `the agent \
                was asked` is the agent's own account of having been asked" \
            retired-kinds="plan · design" \
            retired-because="they were tier gates under the withdrawn ADR.260819.02. A second gate \
                before implementation contradicts `the only gate`"
        requires "a refusal is recorded as a fact, with the condition that caused it" \
            because="a gate never invoked and a gate that refused look identical afterwards"

        // Structural rules that fall out of the relationships above. Each is refusable, and
        // each is enforced by the capability owning the act it refuses — see the invariants.
        rule "dangling-relationship"        refuses="an edge naming something the record does not hold"
        rule "duplicate-identity"           refuses="two entities claiming one id"
        rule "entity-without-identity"      refuses="a node with no id"
        rule "undeclared-entity-kind"       refuses="a kind this schema does not name"
        rule "undeclared-state"             refuses="a state this schema does not name for that kind"
        rule "undeclared-relationship"      refuses="an edge this schema does not name"
        rule "entity-without-required-owner" refuses="an entity that nests with no singular owner"
        rule "unknown-trail-action"         refuses="a trail action outside the vocabulary"
        rule "trail-entry-missing-field"    refuses="a trail entry without at, by or action"
        rule "unknown-approval-kind"        refuses="an approval kind this schema does not name"
        rule "approval-signed-by-agent"     refuses="a signature outside the human namespace"
        rule "adr-accepted-without-approval" refuses="an accepted decision nobody signed"
        rule "iteration-without-signed-admission" refuses="work beginning on an iteration whose admission is unsigned"
        rule "iteration-worked-without-start-vet"  refuses="work beginning on a create-vet alone"
        rule "complete-phase-without-evidence"     refuses="a phase marked complete that produced nothing"
        rule "publish-only-what-survives-freezing" refuses="a read model that does not declare whether it survives being frozen, or declares a lifetime with no reason" \
            because="the publication test is a judgement about perishability, and an unjustified \
                judgement is indistinguishable from an oversight. There is no repository-wide \
                default: perishability belongs to the question, not to the file type" \
            note="a publishable view must also declare WHERE it lands, because the published set is \
                derived from these declarations and from nothing else — an engine that composes its \
                own paths has taken the decision back"
        rule "promoted-truth-is-derived"           refuses="a capability whose promoted truth is not what the record derives from what cut releases bound" \
            because="if it did not come from bound work it is not promotion, it is an assertion \
                about the past — which is the root cause with a version number attached" \
            note="the answer to W7's class. A derived field written once and never rechecked is a \
                cache; one RECOMPUTED by a rule is a projection with a proof attached. The command \
                and the check call the same derivation, so they cannot disagree about what truth is"
        rule "cut-release-is-immutable"            refuses="a cut release whose content no longer matches the seal written when it was cut" \
            because="a release is a POINT on the version line, and a point that moved is not one. \
                Everything downstream — publication, verification, symptom resolution — pins to it" \
            note="the seal makes an edit VISIBLE. It is not a signature and does not make forgery \
                hard: anyone who can edit the record can recompute it. What it catches is the edit \
                nobody meant to make and nobody would otherwise notice, which is the failure this \
                frame is actually about"
        rule "no-silent-drop"                      refuses="a closed iteration carrying a claim that is neither met nor carried by a finding" \
            because="an unmet claim that closes in silence and a met claim look identical \
                afterwards, and the refusal is the only thing that makes them different. This is \
                S5, the symptom with the most day-to-day cost" \
            note="a recorded finding is enough to close. Judging whether the shortfall is \
                acceptable is LEARN's job, not the gate's — this rule refuses silence, never \
                shortfall"
        rule "claim-dropped-from-the-slice"        refuses="an iteration carrying a claim its slice no longer declares" \
            because="every other check here is defeated by editing the claim list, which is exactly \
                how scope goes quietly in a Markdown checklist today. The claims are frozen into \
                the iteration when the gate opens it, so deleting one from the slice does not \
                remove it — it makes the two disagree" \
            note="the check that matters (TS.260820.07). Without it, no-silent-drop is advice"
        rule "evidence-names-its-layer"            refuses="an iteration evidencing a layer its slice never declared" \
            reports="a layer the slice declared that a sealed iteration evidences nothing for" \
            because="the slice set the granularity when it was cut. Evidence outside it is evidence \
                for something nobody asked about, and a declared layer that vanishes from the \
                accounting was never reached AND never refused — which is S2 at layer granularity" \
            note="declared in the storm as a policy the day it was held, and enforced by nothing \
                until ITER.260821.05. Reported rather than refused on the absent side, because an \
                iteration is allowed to close having reached less than it hoped — it is not allowed \
                to do so silently"
        rule "phase-required-by-a-declared-layer"  refuses="a phase skipped while a layer it is the only route to stays sealed and unevidenced" \
            note="which phases are mandatory is decided by the slice's sealed LAYER SET, not by \
                preference. A slice declaring `doctrine` cannot skip teach; one declaring \
                `enforcement` or `docs` cannot skip implement. design-ux and design-system are \
                judgement, and skipping either is a recorded rationale rather than a silence"
        rule "skipped-phase-without-rationale"     refuses="a phase skipped with no reason recorded"
        rule "amendment-records-no-change"  refuses="an amendment that changes nothing"
        rule "slice-without-one-capability" refuses="a slice realizing zero or several capabilities"

        retired "the initiative-era rules" \
            were="slice-under-unadmitted-initiative · slice-delivers-outside-initiative-ask · covers-unknown-obligation" \
            because="they name entities the model no longer has. The one that survived is \
                slice-without-one-capability, which is the same rule against `realizes`"

        // Whether this model is working, six months on. Two of these falsify rather than
        // confirm, and both fail quietly if the model is right on paper and unused in
        // practice — the failure mode a method is least likely to notice about itself.
        fitness "checks-moved-out-of-attestation" \
            text="most of the agent-attested fidelity checks are computed rather than asked"
        fitness "no-drift-between-view-and-record" \
            text="a rendered view and the state it depicts cannot disagree"
        fitness "a-slice-took-more-than-one-iteration" falsifies=#true \
            because="if every slice completes in a single iteration, the iteration is ceremony and should be cut"
        fitness "a-finding-travelled-the-whole-loop" falsifies=#true \
            because="opened by learning, triaged, addressed by a slice, closed by a release that \
                shipped. If none ever completes the circuit, the loop is drawn but not running"
    }

    trail {
        entry at="2026-08-20T00:00:00-05:00" by="agent:principal-engineer" action="created" \
            note="seeded from ES.260819.01 and WALK.260820.01, then falsified by walking the write \
                side end to end (WALK.260820.02). Two undeclared cross-capability edges resolved: \
                one into a new seam, one into per-fact ownership. CAP.delivery-record was tested \
                for a split and survived, with the substrate factored out beneath all five"
        entry at="2026-08-20T00:00:00-05:00" by="agent:principal-engineer" action="amended" \
            note="the schema moved here from the withdrawn ADR.260819.02, sorted on the way in: \
                the model stayed, the encoding and layout rules went to ADR.260819.01, and the \
                rules naming retired entities were retired rather than carried"
        entry at="2026-08-20T00:00:00-05:00" by="agent:principal-engineer" action="checked-against-the-graph" \
            note="all eighteen slices traversed against this record. Read-model ownership matched \
                exactly. Eight cross-capability edges: five dissolved by the two reading rules, \
                two are the known write-side corrections, and one was a genuine gap — \
                release-binding consumes from delivery-record, now declared"
    }
}
