// Four manifests, one npm package, and none of them derived from anything:
//
//   .claude-plugin/plugin.json      0.7.1  "lean wave-based product delivery … three-tier
//   .claude-plugin/marketplace.json 0.7.1   change triage, waves, thin-slices, code
//   .codex-plugin/plugin.json       0.7.1   contribution intake, immutable sprint bridges"
//   .cursor-plugin/plugin.json      0.7.1  keywords: wave-methodology, change-triage,
//   gemini-extension.json           0.7.1            design-approval-gate
//
// The record holds 0.8.0 and retired every one of those words. The manifests are the first
// thing an adopter reads and the only thing a marketplace shows — a published document
// carrying no evidence of when, or whether, it was ever true, which is S6 stated exactly.
//
// And `package.json` ships `skills`, `agents`, `instructions`, `scripts` — not `crates/`, not
// `praxis/`. So the npm package delivers doctrine that says "run `praxis check`" together with
// neither the engine nor the method file, and no workflow builds a binary. Every skill in the
// tree instructs an agent to run a command the package does not contain.

thin-slice "TS.260823.07" {
    slug "one-version-across-every-harness"
    title "Derive every manifest from the record, and ship the engine that backs them"
    kind "command"
    realizes "CAP.multi-harness-distribution"
    from-storm "ES.260819.01"

    command "publish"
    actor "the adopter reading a marketplace entry before installing anything"
    produces-event "ManifestPublished" "ManifestStale"
    needs-read-model "what-this-plugin-ships"

    trigger "a manifest describes a method two versions old and nothing can tell"
    outcome "every harness manifest is projected from the record at the version being published, and the engine ships with them"

    scenario #"""
        Given a record holding a version and what that version means
        When the published set is regenerated
        Then all five manifests are regenerated with it and a hand-edit is visible the way any
             other published drift is — because a manifest is a published document, and the one
             mechanism this repository already trusts is that a published document can prove it
             is unedited.
        """#

    step "1" does="the manifests become projections. Their version, description and keywords come from the record, so a cut version cannot leave five files describing the one before it"
    step "2" does="`verify-published` covers them. The mechanism exists and is the best-grounded thing in this engine; the manifests were simply never inside it"
    step "3" does="the distributed package carries the method file and the engine. Doctrine that instructs an agent to run a command, packaged without that command, is doctrine that cannot be followed"
    step "4" does="a release job builds the binary for the platforms the harnesses run on. Until it exists, `praxis` is a tool only this repository has"

    excludes "adding a sixth harness, or changing how any of the five install. How doctrine \
        REACHES an agent is this capability's and is not what is broken; what is broken is that \
        the description travelling with it is stale and the engine is absent"
    excludes "deciding what the description SAYS. The record already holds the vision, the \
        mission and what each version shipped; this projects them rather than composing new prose"
    excludes "publishing to any registry. Building the artifact and pushing it are different \
        acts, and only the first is a projection"

    layer "doctrine"    reaches="`publish-the-release-set` says the manifests are part of the set, and why a manifest is a published document"
    layer "enforcement" reaches="a hand-edited manifest is caught by `verify-published`; a package missing the engine or the method fails its own check"
    layer "harness"     reaches="all five manifests carry the version the record holds, and the engine is inside what each of the six install paths delivers"
    layer "docs"        reaches="`what version am I installing and what does it mean` is answerable from the manifest, and the answer is derived"

    claim "C1" text="every harness manifest is regenerated by publish and matches the record's version" \
        settled-by="a test publishing a version and asserting all five manifests carry it, none hand-maintained"
    claim "C2" text="a hand-edited manifest is reported by verify-published" \
        settled-by="a test editing a published manifest and asserting the drift is named"
    claim "C3" text="the distributed package contains the method file and the engine" \
        settled-by="a test over the package manifest asserting both are inside what ships, since a skill instructing `praxis check` in a package without praxis is doctrine that cannot be obeyed"
    claim "C4" text="no manifest describes a retired vocabulary" \
        settled-by="the retired-kind check running over the manifests, which is TS.260823.06's rule reaching the files an adopter reads first"

    depends-on "TS.260823.06 — the vocabulary a manifest may use is what that slice declares"

    useful-alone "an adopter stops being told, at the only moment they are deciding, that this is \
        a wave-and-sprint method. Today every marketplace entry describes what was retired, and \
        the package that follows contains no engine to correct the impression"

    attacks "S6"

    useful-to "the-adopter"

    cut-from "the validation review of 2026-08-22, which read all five manifests at 0.7.1 and \
        found the npm file list carrying neither the engine nor the method"

    principle-note "this repository proves its published documents are unedited and leaves five \
        documents outside the proof — the five an adopter reads before any of the others exist \
        for them"

    proves "every manifest a harness reads is derived from the record at a stated version"
    does-not-prove "that the description is a good one, or that an adopter will understand it. \
        It removes the possibility of it being from a different method"
}
